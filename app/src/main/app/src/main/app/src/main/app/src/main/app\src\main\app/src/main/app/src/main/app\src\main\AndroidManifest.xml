package com.oggy.music

import android.os.Bundle
import android.view.ViewGroup
import android.widget.Button
import android.widget.EditText
import android.widget.LinearLayout
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import androidx.media3.common.MediaItem
import androidx.media3.common.PlaybackException
import androidx.media3.common.Player
import androidx.media3.exoplayer.ExoPlayer
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView
import okhttp3.Call
import okhttp3.Callback
import okhttp3.HttpUrl.Companion.toHttpUrl
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.Response
import org.json.JSONObject
import java.io.IOException

data class Song(
    val id: String,
    val title: String,
    val artist: String
)

class MainActivity : AppCompatActivity() {

    private val client = OkHttpClient()
    private lateinit var player: ExoPlayer

    private lateinit var searchInput: EditText
    private lateinit var statusText: TextView
    private lateinit var nowPlaying: TextView
    private lateinit var playPauseButton: Button
    private lateinit var songAdapter: SongAdapter

    private var searchCall: Call? = null
    private var searchVersion = 0
    private var hasSelectedSong = false

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        player = ExoPlayer.Builder(this).build()

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(24, 24, 24, 24)
        }

        val title = TextView(this).apply {
            text = "OGGY MUSIC"
            textSize = 26f
        }

        searchInput = EditText(this).apply {
            hint = "গান বা শিল্পীর নাম লিখুন"
            setSingleLine(true)
        }

        val searchButton = Button(this).apply {
            text = "সার্চ করুন"
        }

        statusText = TextView(this).apply {
            text = "গান খুঁজতে সার্চ করুন"
        }

        songAdapter = SongAdapter { song ->
            playSong(song)
        }

        val songList = RecyclerView(this).apply {
            layoutManager = LinearLayoutManager(this@MainActivity)
            adapter = songAdapter
        }

        nowPlaying = TextView(this).apply {
            text = "কোনো গান চলছে না"
        }

        playPauseButton = Button(this).apply {
            text = "প্লে"
            isEnabled = false
        }

        root.addView(title)
        root.addView(searchInput)
        root.addView(searchButton)
        root.addView(statusText)
        root.addView(
            songList,
            LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                0,
                1f
            )
        )
        root.addView(nowPlaying)
        root.addView(playPauseButton)

        setContentView(root)

        player.addListener(object : Player.Listener {
            override fun onIsPlayingChanged(isPlaying: Boolean) {
                playPauseButton.text = if (isPlaying) "পজ" else "প্লে"
            }

            override fun onPlayerError(error: PlaybackException) {
                statusText.text = "গান চালানো যায়নি। অন্য গান চেষ্টা করুন।"
            }
        })

        searchButton.setOnClickListener {
            val query = searchInput.text.toString().trim()

            if (query.isEmpty()) {
                statusText.text = "প্রথমে গানের নাম লিখুন।"
            } else {
                searchSongs(query)
            }
        }

        playPauseButton.setOnClickListener {
            if (hasSelectedSong) {
                if (player.isPlaying) {
                    player.pause()
                } else {
                    player.play()
                }
            }
        }
    }

    private fun searchSongs(query: String) {
        searchCall?.cancel()
        searchVersion++
        val requestVersion = searchVersion

        statusText.text = "গান খোঁজা হচ্ছে..."
        songAdapter.updateSongs(emptyList())

        val url = "https://discoveryprovider.audius.co/v1/tracks/search"
            .toHttpUrl()
            .newBuilder()
            .addQueryParameter("query", query)
            .addQueryParameter("app_name", "OGGY MUSIC")
            .build()

        val request = Request.Builder()
            .url(url)
            .get()
            .build()

        val call = client.newCall(request)
        searchCall = call

        call.enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {
                if (call.isCanceled()) return

                runOnUiThread {
                    if (requestVersion == searchVersion && !isFinishing) {
                        statusText.text = "ইন্টারনেট বা সার্ভারে সমস্যা হয়েছে।"
                    }
                }
            }

            override fun onResponse(call: Call, response: Response) {
                try {
                    val result = response.use {
                        if (!it.isSuccessful) {
                            throw IOException("HTTP ${it.code}")
                        }
                        it.body?.string() ?: throw IOException("Empty response")
                    }

                    val json = JSONObject(result)
                    val data = json.optJSONArray("data")
                    val songs = mutableListOf<Song>()

                    if (data != null) {
                        for (i in 0 until data.length()) {
                            val item = data.optJSONObject(i) ?: continue
                            val id = item.optString("id", "")
                            val title = item.optString("title", "নামহীন গান")
                            val artist = item.optJSONObject("user")
                                ?.optString("name", "অজানা শিল্পী")
                                ?: "অজানা শিল্পী"

                            if (id.isNotBlank()) {
                                songs.add(Song(id, title, artist))
                            }
                        }
                    }

                    runOnUiThread {
                        if (requestVersion == searchVersion && !isFinishing) {
                            songAdapter.updateSongs(songs)
                            statusText.text = if (songs.isEmpty()) {
                                "কোনো গান পাওয়া যায়নি।"
                            } else {
                                "${songs.size}টি গান পাওয়া গেছে।"
                            }
                        }
                    }
                } catch (e: Exception) {
                    runOnUiThread {
                        if (requestVersion == searchVersion && !isFinishing) {
                            statusText.text =
                                "গানের তালিকা আনা যায়নি। পরে আবার চেষ্টা করুন।"
                        }
                    }
                }
            }
        })
    }

    private fun playSong(song: Song) {
        val streamUrl =
            "https://discoveryprovider.audius.co/v1/tracks/${song.id}/stream"
                .toHttpUrl()
                .newBuilder()
                .addQueryParameter("app_name", "OGGY MUSIC")
                .build()

        nowPlaying.text = "${song.title} — ${song.artist}"
        statusText.text = "গান চালু করা হচ্ছে।"
        hasSelectedSong = true
        playPauseButton.isEnabled = true

        player.setMediaItem(MediaItem.fromUri(streamUrl.toString()))
        player.prepare()
        player.play()
    }

    override fun onDestroy() {
        searchVersion++
        searchCall?.cancel()
        player.release()
        super.onDestroy()
    }
}

class SongAdapter(
    private val onSongClick: (Song) -> Unit
) : RecyclerView.Adapter<SongAdapter.SongViewHolder>() {

    private val songs = mutableListOf<Song>()

    fun updateSongs(newSongs: List<Song>) {
        songs.clear()
        songs.addAll(newSongs)
        notifyDataSetChanged()
    }

    override fun onCreateViewHolder(
        parent: ViewGroup,
        viewType: Int
    ): SongViewHolder {
        val textView = TextView(parent.context).apply {
            layoutParams = RecyclerView.LayoutParams(
                RecyclerView.LayoutParams.MATCH_PARENT,
                RecyclerView.LayoutParams.WRAP_CONTENT
            )
            setPadding(24, 24, 24, 24)
            textSize = 16f
        }
        return SongViewHolder(textView)
    }

    override fun onBindViewHolder(holder: SongViewHolder, position: Int) {
        val song = songs[position]
        (holder.itemView as TextView).text = "${song.title}\n${song.artist}"
        holder.itemView.setOnClickListener {
            onSongClick(song)
        }
    }

    override fun getItemCount(): Int = songs.size

    class SongViewHolder(view: android.view.View) :
        RecyclerView.ViewHolder(view)
}
